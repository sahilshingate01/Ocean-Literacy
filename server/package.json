{
  "name": "ocean-literacy-server",
  "version": "2.0.0",
  "description": "Production-ready full-stack backend service, API, and INCOIS integration layer for Ocean Literacy Platform",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
