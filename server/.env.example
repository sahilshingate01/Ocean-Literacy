# Ocean Literacy Platform - Phase 2 Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,file://

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://sahilshingate@localhost:5432/ocean_literacy_dev"

# Security & JWT Secrets (Change these in production!)
JWT_SECRET=ocean_literacy_jwt_secret_dev_key_must_be_at_least_32_characters_long_for_security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=ocean_literacy_cookie_secret_dev_32_chars_long
SECURE_COOKIES=false

# Leaderboard Timezone (Defaults to Asia/Kolkata for INCOIS operations)
LEADERBOARD_TIMEZONE=Asia/Kolkata

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# INCOIS Service Integration Configuration
INCOIS_BASE_URL="https://www.incois.gov.in"
INCOIS_PFZ_URL="https://www.incois.gov.in/MarineFisheries/PfzAdvisory"
INCOIS_OSF_URL="https://www.incois.gov.in/site/services/osf.jsp"
INCOIS_SAMUDRA_URL="https://www.incois.gov.in/site/SAMUDRA/index.html"
INCOIS_TEWS_URL="https://tsunami.incois.gov.in/TEWS/about.jsp"
INCOIS_REQUEST_TIMEOUT_MS=6000
INCOIS_CACHE_TTL_SECONDS=900
INCOIS_MOCK_FALLBACK_ENABLED=true
